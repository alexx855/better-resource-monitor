{
  "name": "better-resource-monitor",
  "private": false,
  "version": "1.1.6",
  "packageManager": "pnpm@10.33.2",
  "description": "A blazing-fast, lightweight menu bar system monitor for macOS. Monitor CPU, Memory, Storage, GPU, and Network usage with minimal resource consumption. Features native GPU monitoring, dark/light theme support, and customizable display options.",
  "author": {
    "name": "Alex Pedersen",
    "email": "hello@alexpedersen.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexx855/better-resource-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/alexx855/better-resource-monitor/issues"
  },
  "homepage": "https://better-resource-monitor.alexpedersen.dev/",
  "keywords": [
    "macos",
    "menu-bar",
    "menubar-app",
    "system-monitor",
    "apple-silicon",
    "rust",
    "cpu-monitor",
    "gpu-monitor",
    "memory-monitor",
    "network-monitor",
    "tray-icon",
    "menu-bar-app",
    "macos-app",
    "tauri",
    "rust-lang",
    "activity-monitor",
    "istat-menus"
  ],
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:www": "pnpm --filter www dev",
    "build:www": "pnpm --filter www build",
    "preview:www": "pnpm --filter www preview",
    "check:www": "pnpm --filter www check",
    "build:screenshots": "bash scripts/images-helper.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "undici": "7.28.0",
      "ws": "8.21.0"
    }
  }
}
