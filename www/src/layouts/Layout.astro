---
import { getEntry } from "astro:content";
import { getAlternateLinks, getLocaleMeta, getLocalizedPath, type SupportedLocale } from "../lib/site";


interface Props {
  title: string;
  description: string;
  locale: SupportedLocale;
  slug: string;
  ogImage?: string;
  ogImageAlt?: string;
  preloadImage?: string;
  robots?: string;
  omitCanonical?: boolean;
}

const {
  title,
  description,
  locale,
  slug,
  ogImage = "/images/og-index-en.png",
  ogImageAlt = title,
  preloadImage,
  robots = "index, follow",
  omitCanonical = false,
} = Astro.props;
const localeMeta = getLocaleMeta(locale);
const uiEntry = await getEntry("ui", locale);
if (!uiEntry) throw new Error(`Missing UI content for ${locale}`);
const labels = uiEntry.data;
const alternateLinks = getAlternateLinks(slug);
const ogAlternateLocales = alternateLinks
  .filter((link) => link.locale !== locale)
  .map((link) => getLocaleMeta(link.locale).ogLocale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
---

<!doctype html>
<html lang={localeMeta.langTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Alex Pedersen" />
    <meta name="application-name" content="Better Resource Monitor" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#18120f" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!omitCanonical && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Better Resource Monitor" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {ogAlternateLocales.map((value) => <meta property="og:locale:alternate" content={value} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alexx855" />
    <meta name="twitter:creator" content="@alexx855" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {!omitCanonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="text/plain" href={new URL("/llms.txt", Astro.site).href} title="LLMs.txt" />
    <link rel="alternate" type="application/json" href={new URL("/agent-facts.json", Astro.site).href} title="Agent facts" />
    {!omitCanonical && alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hrefLang} href={new URL(link.href, Astro.site).href} />
    ))}
    {!omitCanonical && <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath("en", slug), Astro.site).href} />}
    <meta name="robots" content={robots} />
    <title>{title}</title>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Better Resource Monitor",
      "description": description,
      "url": siteUrl,
      "inLanguage": localeMeta.langTag,
      "applicationCategory": "UtilitiesApplication",
      "applicationSubCategory": "Menu Bar Monitor",
      "operatingSystem": "macOS",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "Alex Pedersen", "url": "https://github.com/alexx855" },
      "downloadUrl": "https://apps.apple.com/app/better-resource-monitor/id6758237306",
      "isAccessibleForFree": true,
      "featureList": [
        "CPU monitoring",
        "Memory pressure monitoring",
        "Storage monitoring",
        "GPU monitoring",
        "Network monitoring",
        "Menu bar display",
        "Sandboxed",
        "No telemetry",
        "No admin password",
        "No root helper",
        "No private APIs"
      ],
      "screenshot": ogImageUrl,
      "license": "https://opensource.org/licenses/MIT"
    })} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Better Resource Monitor",
      "url": siteUrl,
      "inLanguage": localeMeta.langTag,
      "publisher": { "@type": "Person", "name": "Alex Pedersen", "url": "https://alexpedersen.dev/" },
    })} />

    <style is:global>
      /* Hallmark · macrostructure: Long Document · tone: warm utility manual · anchor hue: ember
       * design-system: DESIGN.md · contrast: pass (40–41) · mobile: pass (34, 49, 50–57)
       * Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
      :root {
        /* Colors */
        --c-bg: #18120f;
        --c-surface: #211914;
        --c-surface-alt: #2a211c;
        --c-border: #4a382e;
        --c-brand: #d14715;
        --c-on-brand: #ffffff;
        --c-text: #fff8f2;
        --c-text-dim: #dcc9bc;

        /* Spacing */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 24px;
        --space-6: 32px;
        --space-10: 64px;
        --space-inline-x: 0.4em;
        --space-inline-y: 0.2em;

        /* Layout */
        --max-width: 900px;
        --touch-target: 44px;
        --border-width: 1px;
        --border-width-thick: 4px;

        /* Typography */
        --fs-xs: 0.75rem;
        --fs-sm: 0.875rem;
        --fs-base: 1rem;
        --fs-md: 1.25rem;
        --fs-lg: clamp(1.35rem, 3vw, 1.65rem);
        --fs-xl: clamp(1.85rem, 5vw, 2.4rem);
        --fs-2xl: clamp(2.6rem, 9vw, 4.9rem);

        /* Font */
        --font-mono: ui-monospace, "Cascadia Code", "Source Code Pro", menlo,
          monospace;

        /* Easing */
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);

        /* Transitions */
        --transition-fast: 0.15s var(--ease-out);
        --transition-normal: 0.2s var(--ease-out);
      }

      /* Base reset */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        overflow-x: clip;
      }

      html {
        scroll-behavior: smooth;
      }

      img,
      video,
      iframe {
        max-width: 100%;
        height: auto;
      }

      body {
        font: 400 16px/1.6 var(--font-mono);
        background: var(--c-bg);
        color: var(--c-text);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: linear-gradient(90deg, color-mix(in srgb, var(--c-border) 28%, transparent) 1px, transparent 1px), linear-gradient(color-mix(in srgb, var(--c-border) 28%, transparent) 1px, transparent 1px);
        background-size: 56px 56px;
        opacity: 0.62;
      }

      ::selection {
        background: var(--c-text);
        color: var(--c-bg);
      }

      @media (min-width: 700px) {
        body {
          font-size: 17px;
        }
      }
      @media (min-width: 1100px) {
        body {
          font-size: 18px;
        }
      }

      /* Typography */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font: inherit;
        font-weight: 600;
        line-height: 1.2;
        color: var(--c-text);
        margin: 0 0 var(--space-5);
        padding-top: var(--space-5);
        text-wrap: balance;
        overflow-wrap: anywhere;
        min-width: 0;
      }

      h1 {
        font-size: var(--fs-2xl);
      }

      h2 {
        font-size: var(--fs-xl);
      }

      h3 {
        font-size: var(--fs-lg);
      }

      h4 {
        font-size: var(--fs-md);
      }

      p {
        margin: 0 0 var(--space-5);
        color: var(--c-text-dim);
        font-size: var(--fs-base);
        overflow-wrap: break-word;
      }

      p + p {
        margin-top: var(--space-4);
      }

      strong {
        color: var(--c-text);
        font-weight: 600;
      }

      a * {
        color: inherit;
      }

      /*
        Links — one compact style for all text links: brand fill + white text,
        with no decorative bottom edge. Exceptions: badge image links (`a:has(img)`) and
        `.comparison-card` keep their own undecorated / card treatment.
      */
      a:not(:has(img)):not(.comparison-card) {
        color: var(--c-on-brand);
        background-color: var(--c-brand);
        background-image: none;
        box-shadow: none;
        text-decoration: none;
        border: var(--border-width) solid transparent;
        padding: 0 var(--space-inline-x);
        margin: 0;
        overflow-wrap: anywhere;
        display: inline-block;
        font-size: 0.95em;
        transform: translateY(0) scale(1);
        transition: transform 120ms var(--ease-out);
        vertical-align: baseline;
      }

      a:has(img) {
        color: inherit;
        padding: 0;
        margin: 0;
        background: transparent;
        background-image: none;
        box-shadow: none;
        text-decoration: none;
        display: inline;
        transform: none;
        transition: none;
      }

      /* Touch / non-hover pointers: press scale without needing :hover */
      a:not(:has(img)):not(.comparison-card):active {
        transform: scale(0.97);
      }

      a[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.55;
        pointer-events: none;
      }

      @media (hover: hover) and (pointer: fine) {
        a:has(img):hover {
          background: transparent;
          box-shadow: none;
        }
      }

      *:focus-visible {
        outline: var(--border-width-thick) solid var(--c-brand);
        outline-offset: 2px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      a.home-link:not(:has(img)) {
        font-weight: bold;
        font-size: clamp(1rem, 4vw, 1.6rem);
        line-height: 1;
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        width: fit-content;
        max-width: 100%;
        padding: var(--space-2) var(--space-3);
        margin: 0 0 var(--space-6);
        overflow-wrap: normal;
      }

      .home-link__arrow {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
      }

      .home-link__arrow svg {
        /* Tight viewBox; oversized vs em so open chevron optically matches bold caps */
        width: 1.25em;
        height: 1.25em;
      }

      .home-link__title {
        color: inherit;
        background: transparent;
        background-image: none;
        padding: 0;
        margin: 0;
        text-decoration: none;
        font-size: 1em;
        line-height: 1;
        white-space: nowrap;
      }

      /* Container */
      .container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: clamp(var(--space-4), 4vw, var(--space-6));
        flex: 1;
      }

      /* Lists */
      ul,
      ol {
        margin-bottom: var(--space-5);
        padding-left: 0;
        color: var(--c-text-dim);
      }

      li {
        margin-bottom: var(--space-2);
        padding-left: 0;
      }

      /* Code Blocks */
      code,
      pre {
        font-family: inherit;
        font-size: 0.95em;
      }

      pre {
        background: var(--c-surface-alt);
        padding: var(--space-5);
        overflow-x: auto;
        margin: 0 0 var(--space-5);
        border: var(--border-width) solid var(--c-border);
        border-left: 4px solid var(--c-brand);
        color: var(--c-text);
      }

      pre code {
        background: transparent;
        padding: 0;
        color: var(--c-text);
      }

      pre.astro-code span[style*="6A737D" i] {
        color: color-mix(in srgb, var(--c-brand) 48%, var(--c-text)) !important;
      }

      /* Inline code */
      p code,
      li code {
        background: var(--c-surface-alt);
        padding: var(--space-inline-y) var(--space-inline-x);
        color: var(--c-text);
        border: var(--border-width) solid var(--c-border);
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: var(--space-5) 0;
        border: var(--border-width) solid var(--c-border);
        background: var(--c-surface);
      }

      .table-scroll {
        margin: var(--space-5) 0;
        overflow-x: auto;
        border: var(--border-width) solid var(--c-border);
        background: var(--c-surface);
      }

      .table-scroll table {
        min-width: 44rem;
        margin: 0;
        border: 0;
      }

      th,
      td {
        padding: var(--space-3) var(--space-5);
        text-align: left;
        border-bottom: var(--border-width) solid var(--c-border);
      }

      th {
        background: var(--c-surface-alt);
        color: var(--c-text);
        font-weight: 600;
        text-transform: uppercase;
        font-size: var(--fs-xs);
        letter-spacing: 0.05em;
      }

      tbody th {
        background: transparent;
        font-size: var(--fs-base);
        letter-spacing: 0;
        text-transform: none;
      }

      tr:last-child th,
      tr:last-child td {
        border-bottom: none;
      }

      /* Horizontal Rule */
      hr {
        border: 0;
        height: var(--border-width);
        background: var(--c-border);
        margin: var(--space-10) 0;
      }

      /* Content Page Specifics */
      .content-page .container {
        padding-top: var(--space-5);
      }

      /* Shared panel chrome for FAQ items, comparison cards, etc.
         Same fill as table headers; same border as tables. */
      .content-panel {
        border: var(--border-width) solid var(--c-border);
        background: var(--c-surface-alt);
      }

      /* Blockquotes */
      blockquote {
        padding: var(--space-3) var(--space-4);
        margin: var(--space-4) 0;
        background: color-mix(in srgb, var(--c-brand) 8%, var(--c-surface));
      }

      blockquote p {
        margin-bottom: var(--space-2);
      }

      blockquote p:last-child {
        margin-bottom: 0;
      }

      /* Footer */
      .site-footer {
        margin-top: auto;
      }

      .site-footer .container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) clamp(var(--space-4), 4vw, var(--space-6));
        padding-top: var(--space-6);
        padding-bottom: var(--space-6);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-2) var(--space-3);
      }

      a.footer-link:not(:has(img)) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: var(--fs-sm);
        line-height: 1.35;
        text-align: center;
        overflow-wrap: normal;
      }

      @media (hover: hover) and (pointer: fine) {
        /* Lift only — no color change */
        a:not(:has(img)):not(.comparison-card):hover {
          transform: translateY(-1px);
          color: var(--c-on-brand);
          background-color: var(--c-brand);
          background-image: none;
          box-shadow: none;
          text-decoration: none;
        }

        /*
          Press must follow hover: same specificity, later source order so
          :active scale wins over :hover lift while the pointer is down.
        */
        a:not(:has(img)):not(.comparison-card):active {
          transform: scale(0.97);
        }
      }

      a:not(:has(img)):not(.comparison-card):focus-visible {
        color: var(--c-on-brand);
        background-color: var(--c-brand);
        background-image: none;
        box-shadow: none;
        text-decoration: none;
      }

      /* Responsive */
      @media (max-width: 768px) {
        h1 {
          font-size: var(--fs-xl);
        }

        pre {
          margin-left: calc(-1 * var(--space-5));
          margin-right: calc(-1 * var(--space-5));
          border-left: 0;
          border-right: 0;
        }

        table {
          display: block;
          overflow-x: auto;
        }

        .table-scroll table {
          display: table;
          overflow-x: visible;
        }
      }

      @media (max-width: 600px) {
        .container {
          padding: 0 var(--space-5);
        }

        .site-footer .container {
          flex-direction: column;
          align-items: stretch;
          justify-content: flex-start;
        }

        .footer-links {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          justify-content: flex-start;
          text-align: left;
          gap: var(--space-2) var(--space-3);
        }

        .footer-link {
          justify-content: flex-start;
          text-align: left;
        }
      }

      @media (max-width: 360px) {
        a.home-link:not(:has(img)) {
          font-size: var(--fs-sm);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        a:not(:has(img)):not(.comparison-card):active {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <div>
      <slot />
    </div>
    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links" aria-label={labels.footer.internalNavigation}>
          <a class="footer-link footer-link--internal" href={getLocalizedPath(locale, "comparison")}>{labels.footer.comparison}</a>
          <a class="footer-link footer-link--internal" href={getLocalizedPath(locale, "privacy-policy")}>{labels.footer.privacyPolicy}</a>
          <a class="footer-link footer-link--internal" href={getLocalizedPath(locale, "terms")}>{labels.footer.terms}</a>
        </nav>
        <nav class="footer-links" aria-label={labels.footer.externalNavigation}>
          <a
            class="footer-link footer-link--external"
            href="https://github.com/alexx855/better-resource-monitor/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.license}</a
          >
          <a
            class="footer-link footer-link--external"
            href="https://github.com/alexx855/better-resource-monitor/issues/new"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.support}</a
          >
          <a
            class="footer-link footer-link--external"
            href="https://github.com/alexx855/better-resource-monitor"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.github}</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
