---
import { getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { getAlternateLinks, getLocaleMeta, getLocalizedPath, type SupportedLocale } from "../lib/site";


interface Props {
  title: string;
  description: string;
  locale: SupportedLocale;
  slug: string;
  ogImage?: string;
  ogImageAlt?: string;
  preloadImage?: string;
  robots?: string;
}

const {
  title,
  description,
  locale,
  slug,
  ogImage = "/images/og-index-en.png",
  ogImageAlt = title,
  preloadImage,
  robots = "index, follow",
} = Astro.props;
const localeMeta = getLocaleMeta(locale);
const uiEntry = await getEntry("ui", locale);
if (!uiEntry) throw new Error(`Missing UI content for ${locale}`);
const labels = uiEntry.data;
const alternateLinks = getAlternateLinks(slug);
const ogAlternateLocales = alternateLinks
  .filter((link) => link.locale !== locale)
  .map((link) => getLocaleMeta(link.locale).ogLocale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
---

<!doctype html>
<html lang={localeMeta.langTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Alex Pedersen" />
    <meta name="application-name" content="Better Resource Monitor" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#18120f" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Better Resource Monitor" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {ogAlternateLocales.map((value) => <meta property="og:locale:alternate" content={value} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alexx855" />
    <meta name="twitter:creator" content="@alexx855" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href={new URL("/llms.txt", Astro.site).href} title="LLMs.txt" />
    <link rel="alternate" type="application/json" href={new URL("/agent-facts.json", Astro.site).href} title="Agent facts" />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hrefLang} href={new URL(link.href, Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath("en", slug), Astro.site).href} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <ClientRouter />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Better Resource Monitor",
      "description": description,
      "url": siteUrl,
      "inLanguage": localeMeta.langTag,
      "applicationCategory": "UtilitiesApplication",
      "applicationSubCategory": "Menu Bar Monitor",
      "operatingSystem": "macOS",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "Alex Pedersen", "url": "https://github.com/alexx855" },
      "downloadUrl": "https://apps.apple.com/app/better-resource-monitor/id6758237306",
      "isAccessibleForFree": true,
      "featureList": "Cross-Platform, Lightweight, GPU Monitoring, Theme Aware, Configurable, Private",
      "screenshot": ogImageUrl,
      "codeRepository": "https://github.com/alexx855/better-resource-monitor",
      "license": "https://opensource.org/licenses/MIT"
    })} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Better Resource Monitor",
      "url": siteUrl,
      "inLanguage": localeMeta.langTag,
      "publisher": { "@type": "Person", "name": "Alex Pedersen", "url": "https://alexpedersen.dev/" },
    })} />

    <style is:global>
      :root {
        /* Colors */
        --c-bg: #18120f;
        --c-surface: #211914;
        --c-surface-alt: #2a211c;
        --c-border: #4a382e;
        --c-brand: #D14715;
        --c-on-brand: #ffffff;
        --c-text: #fff8f2;
        --c-text-dim: #dcc9bc;

        /* Spacing */
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 24px;
        --space-6: 32px;
        --space-10: 64px;

        /* Layout */
        --max-width: 900px;
        --touch-target: 44px;
        --border-width: 1px;
        --border-width-thick: 4px;

        /* Typography */
        --fs-xs: 0.75rem;
        --fs-sm: 0.875rem;
        --fs-base: 1rem;
        --fs-md: 1.25rem;
        --fs-lg: clamp(1.35rem, 3vw, 1.65rem);
        --fs-xl: clamp(1.85rem, 5vw, 2.4rem);
        --fs-2xl: clamp(2.6rem, 9vw, 4.9rem);

        /* Font */
        --font-mono: ui-monospace, "Cascadia Code", "Source Code Pro", menlo,
          monospace;

        /* Easing */
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);

        /* Transitions */
        --transition-fast: 0.15s var(--ease-out);
        --transition-normal: 0.2s var(--ease-out);
        --transition-hover: 0.18s ease;
      }

      /* Base reset */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }

      html {
        scroll-behavior: smooth;
      }

      img,
      video,
      iframe {
        max-width: 100%;
        height: auto;
      }

      body {
        font: 400 16px/1.6 var(--font-mono);
        background:
          radial-gradient(circle at 12% -10%, color-mix(in srgb, var(--c-brand) 22%, transparent), transparent 32rem),
          radial-gradient(circle at 85% 12%, color-mix(in srgb, var(--c-brand) 10%, transparent), transparent 26rem),
          linear-gradient(135deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 18px),
          var(--c-bg);
        color: var(--c-text);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      ::selection {
        background: var(--c-text);
        color: var(--c-bg);
      }

      @media (min-width: 700px) {
        body {
          font-size: 17px;
        }
      }
      @media (min-width: 1100px) {
        body {
          font-size: 18px;
        }
      }

      /* Typography */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font: inherit;
        font-weight: 600;
        line-height: 1.2;
        color: var(--c-text);
        margin: 0 0 var(--space-5);
        padding-top: var(--space-5);
        text-wrap: balance;
      }

      h1 {
        font-size: var(--fs-2xl);
      }

      h2 {
        font-size: var(--fs-xl);
      }

      h3 {
        font-size: var(--fs-lg);
      }

      h4 {
        font-size: var(--fs-md);
      }

      p {
        margin: 0 0 var(--space-5);
        color: var(--c-text-dim);
        font-size: var(--fs-base);
        overflow-wrap: break-word;
      }

      p + p {
        margin-top: var(--space-4);
      }

      strong {
        color: var(--c-text);
        font-weight: 600;
      }

      a * {
        color: inherit;
      }

      /* Links */
      a {
        color: var(--c-on-brand);
        background-color: var(--c-brand);
        background-image:
          linear-gradient(color-mix(in srgb, var(--c-brand), #000 16%), color-mix(in srgb, var(--c-brand), #000 16%)),
          linear-gradient(var(--c-brand), var(--c-brand));
        background-position: 0 100%, 0 0;
        background-repeat: no-repeat;
        background-size: 100% 0, 100% 100%;
        text-decoration: none;
        padding: 2px 4px;
        margin: 0 -4px;
      }

      p a:not(:has(img)),
      li a:not(:has(img)),
      dd a:not(:has(img)) {
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }

      a:has(img) {
        padding: 0;
        margin: 0;
        background-color: transparent;
        background-image: none;
      }

      @media (hover: hover) and (pointer: fine) {
        a:hover {
          background-size: 100% 0, 100% 100%;
        }

        a:has(img):hover {
          background-color: transparent;
        }
      }

      *:focus-visible {
        outline: var(--border-width-thick) solid var(--c-brand);
        outline-offset: 2px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .home-link {
        font-weight:bold;
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        width: fit-content;
        color: var(--c-on-brand);
        background-color: var(--c-brand);
        background-image:
          linear-gradient(color-mix(in srgb, var(--c-brand), #000 16%), color-mix(in srgb, var(--c-brand), #000 16%)),
          linear-gradient(var(--c-brand), var(--c-brand));
        background-position: 0 100%, 0 0;
        background-repeat: no-repeat;
        background-size: 100% 0, 100% 100%;
        padding: 2px 4px;
        margin: 0 0 var(--space-6);
      }

      .home-link__title {
        color: inherit;
        background: transparent;
        background-image: none;
        padding: 0;
        margin: 0;
        text-decoration: none;
        view-transition-name: site-title;
        font-size: clamp(1.15rem, 4vw, 1.6rem);
        line-height: 1;
      }

      @media (hover: hover) and (pointer: fine) {
        .home-link:hover {
          background-size: 100% 0, 100% 100%;
        }
      }

      /* Container */
      .container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: clamp(var(--space-4), 4vw, var(--space-6));
        flex: 1;
      }

      /* Lists */
      ul,
      ol {
        margin-bottom: var(--space-5);
        padding-left: var(--space-5);
        color: var(--c-text-dim);
      }

      li {
        margin-bottom: var(--space-2);
        padding-left: var(--space-2);
      }

      /* Code Blocks */
      code,
      pre {
        font-family: inherit;
        font-size: 0.95em;
      }

      pre {
        background: var(--c-surface-alt);
        padding: var(--space-5);
        overflow-x: auto;
        margin: 0 0 var(--space-5);
        border: var(--border-width) solid var(--c-border);
        border-left: 4px solid var(--c-brand);
        color: var(--c-text);
      }

      pre code {
        background: transparent;
        padding: 0;
        color: var(--c-text);
      }

      pre.astro-code span[style*="6A737D" i] {
        color: #ffad75 !important;
      }

      /* Inline code */
      p code,
      li code {
        background: var(--c-surface-alt);
        padding: 0.2em 0.4em;
        color: var(--c-text);
        border: var(--border-width) solid var(--c-border);
      }

      /* Tables */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: var(--space-5) 0;
        border: var(--border-width) solid var(--c-border);
        background: var(--c-surface);
      }

      .table-scroll {
        margin: var(--space-5) 0;
        overflow-x: auto;
        border: var(--border-width) solid var(--c-border);
        background: var(--c-surface);
      }

      .table-scroll table {
        min-width: 44rem;
        margin: 0;
        border: 0;
      }

      th,
      td {
        padding: var(--space-3) var(--space-5);
        text-align: left;
        border-bottom: var(--border-width) solid var(--c-border);
      }

      th {
        background: var(--c-surface-alt);
        color: var(--c-text);
        font-weight: 600;
        text-transform: uppercase;
        font-size: var(--fs-xs);
        letter-spacing: 0.05em;
      }

      tbody th {
        background: transparent;
        font-size: var(--fs-base);
        letter-spacing: 0;
        text-transform: none;
      }

      tr:last-child th,
      tr:last-child td {
        border-bottom: none;
      }

      /* Horizontal Rule */
      hr {
        border: 0;
        height: var(--border-width);
        background: var(--c-border);
        margin: var(--space-10) 0;
      }

      /* Content Page Specifics */
      .content-page .container {
        padding-top: var(--space-5);
      }

      /* Blockquotes */
      blockquote {
        padding: var(--space-3) var(--space-4);
        margin: var(--space-4) 0;
        background: color-mix(in srgb, var(--c-brand) 8%, var(--c-surface));
      }

      blockquote p {
        margin-bottom: var(--space-2);
      }

      blockquote p:last-child {
        margin-bottom: 0;
      }

      /* Footer */
      .site-footer {
        border-top: var(--border-width) solid var(--c-border);
        background: transparent;
        margin-top: auto;
      }

      .site-footer .container {
        padding-top: var(--space-6);
        padding-bottom: var(--space-6);
      }

      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-2) clamp(var(--space-4), 4vw, var(--space-6));
      }

      .site-footer nav a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--c-text-dim);
        background: transparent;
        background-image: linear-gradient(var(--c-brand), var(--c-brand));
        background-position: 0 calc(100% - 0.18em);
        background-repeat: no-repeat;
        background-size: 0 var(--border-width);
        padding: 0 var(--space-1);
        margin: 0;
        font-size: var(--fs-sm);
        line-height: 1.35;
        text-align: center;
        text-decoration-line: underline;
        text-decoration-thickness: var(--border-width);
        text-decoration-color: color-mix(in srgb, var(--c-brand) 55%, transparent);
        text-underline-offset: 0.28em;
        overflow-wrap: anywhere;
      }

      @media (hover: hover) and (pointer: fine) {
        .site-footer nav a:hover {
          color: var(--c-text-dim);
          background: transparent;
          background-size: 0 var(--border-width);
          text-decoration-color: color-mix(in srgb, var(--c-brand) 55%, transparent);
        }
      }

      .site-footer nav a:focus-visible {
        color: var(--c-text);
        text-decoration-color: var(--c-brand);
      }

      /* Responsive */
      @media (max-width: 768px) {
        h1 {
          font-size: var(--fs-xl);
        }

        pre {
          margin-left: calc(-1 * var(--space-5));
          margin-right: calc(-1 * var(--space-5));
          border-left: 0;
          border-right: 0;
        }

        table {
          display: block;
          overflow-x: auto;
        }

        .table-scroll table {
          display: table;
          overflow-x: visible;
        }
      }

      @media (max-width: 600px) {
        .site-footer nav {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          justify-content: flex-start;
          text-align: left;
          gap: var(--space-2) var(--space-3);
        }

        .site-footer nav a {
          justify-content: flex-start;
          text-align: left;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

      }
    </style>
  </head>
  <body>
    <div>
      <slot />
    </div>
    <footer class="site-footer">
      <div class="container">
        <nav aria-label={labels.footer.navigation}>
          <a href={getLocalizedPath(locale, "comparison")}>{labels.footer.comparison}</a>
          <a href={getLocalizedPath(locale, "privacy-policy")}>{labels.footer.privacyPolicy}</a>
          <a href={getLocalizedPath(locale, "terms")}>{labels.footer.terms}</a>
          <a
            href="https://github.com/alexx855/better-resource-monitor/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.license}</a
          >
          <a
            href="https://github.com/alexx855/better-resource-monitor/issues/new"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.support}</a
          >
          <a
            href="https://github.com/alexx855/better-resource-monitor"
            target="_blank"
            rel="noopener noreferrer">{labels.footer.github}</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
