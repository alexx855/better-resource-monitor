---
import { getEntry } from "astro:content";
import FaqSection from "../FaqSection.astro";
import HomeLink from "../HomeLink.astro";
import Layout from "../../layouts/Layout.astro";
import { getLocalizedPath, type SupportedLocale } from "../../lib/site";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const uiEntry = await getEntry("ui", locale);
const faqEntry = await getEntry("faq", locale);
if (!uiEntry || !faqEntry) throw new Error(`Missing content for ${locale}`);
const ui = uiEntry.data;
const faq = faqEntry.data;
---

<Layout title={faq.title} description={faq.description} locale={locale} slug="faq" ogImage={faq.ogImage}>
  <style is:global>
    @media (max-width: 600px) {
      .container {
        padding: 0 var(--space-5);
      }
    }
  </style>

  <main class="content-page">
    <div class="container">
      <HomeLink href={getLocalizedPath(locale)} label={ui.backToHome} />
      <FaqSection locale={locale} heading={faq.heading} headingLevel="h1" items={faq.items} />
    </div>
  </main>
</Layout>
