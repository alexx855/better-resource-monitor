---
import { getEntry, render } from "astro:content";
import FaqSection from "../FaqSection.astro";
import Layout from "../../layouts/Layout.astro";
import type { SupportedLocale } from "../../lib/site";
import { embeddedFaqHeadings, pickFaqItems } from "../../lib/embedded-faqs";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const metaEntry = await getEntry("home", locale);
const bodyEntry = await getEntry("homeBody", locale);
const faqEntry = await getEntry("faq", locale);
if (!metaEntry || !bodyEntry || !faqEntry) throw new Error(`Missing home content for ${locale}`);
const home = metaEntry.data;
const { Content } = await render(bodyEntry);
const faqItems = pickFaqItems(faqEntry.data.items, "home");
---

<Layout
  title={home.title}
  description={home.description}
  locale={locale}
  slug=""
  ogImage={home.ogImage}
  preloadImage="/better-resource-monitor-storage.png"
>
  <style is:global>
    /* Hallmark · macrostructure: Long Document · tone: warm utility manual · anchor hue: ember
     * design-system: DESIGN.md · contrast: pass (40–41) · mobile: pass (34, 49, 50–57)
     * Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
    .home-document {
      padding-top: clamp(var(--space-5), 7vw, var(--space-10));
    }

    .home-document article > h1 {
      max-width: 16ch;
      margin: 0 0 var(--space-4);
      padding: var(--space-4) 0 0;
      text-align: left;
      overflow-wrap: anywhere;
    }

    .home-document article > h1 + p {
      max-width: 64ch;
      margin-bottom: var(--space-6);
      text-align: left;
    }

    p[align="center"] img[alt="Better Resource Monitor"] {
      width: auto;
      max-width: 100%;
      height: auto;
      border-radius: 0;
    }

    p[align="center"] img[src*="/badges/"] {
      width: 270px;
      max-width: 100%;
      height: auto;
      aspect-ratio: 270 / 65;
    }

    p[align="center"] img[src*="/images/simplicity-"] {
      width: 100%;
      max-width: 100%;
      height: auto;
      border: var(--border-width) solid var(--c-border);
    }

    p[align="center"]:has(img[src*="/badges/"]) {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: var(--space-5);
      padding-top: var(--space-5);
    }

    p[align="center"]:has(img[src*="/badges/"]) a {
      line-height: 1;
    }

    .home-document article > p[align="center"]:not(:has(img)):has(a) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      column-gap: 0;
      row-gap: var(--space-2);
      font-size: 0;
      text-align: left;
    }

    .home-document article > p[align="center"]:not(:has(img)):has(a) a,
    .home-document article > p[align="center"]:not(:has(img)):has(a) span {
      font-size: var(--fs-sm);
    }

    .home-document article > p[align="center"]:not(:has(img)):has(a) a:not(:last-of-type) {
      margin-inline-end: var(--space-2);
    }

    .home-document article > h2 {
      margin-top: var(--space-10);
      padding-top: var(--space-5);
      scroll-margin-top: var(--space-5);
    }

    .home-document article > h2 + p {
      max-width: 68ch;
    }

    .home-document .faq-section {
      padding-top: var(--space-6);
    }

    @media (max-width: 600px) {
      p[align="center"]:has(img[src*="/badges/"]) {
        justify-content: flex-start;
        gap: var(--space-3);
        flex-wrap: wrap;
      }

      p[align="center"]:not(:has(img)):has(a) a {
        font-size: var(--fs-sm);
        white-space: nowrap;
      }
    }
  </style>

  <main class="container home-document">
    <article>
      <Content />
    </article>
    <FaqSection locale={locale} heading={embeddedFaqHeadings.home[locale]} items={faqItems} />
  </main>
</Layout>
