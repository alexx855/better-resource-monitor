---
import { getEntry } from "astro:content";
import FaqSection from "../FaqSection.astro";
import HomeLink from "../HomeLink.astro";
import Layout from "../../layouts/Layout.astro";
import { getComparisonPath, getLocalizedPath, type ComparisonPageKey, type SupportedLocale } from "../../lib/site";
import { embeddedFaqHeadings, getComparisonIndexFaqItems, pickFaqItems } from "../../lib/embedded-faqs";

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const uiEntry = await getEntry("ui", locale);
const faqEntry = await getEntry("faq", locale);
if (!uiEntry || !faqEntry) throw new Error(`Missing content for ${locale}`);
const ui = uiEntry.data;

const pageCopy = {
  en: {
    title: "Mac Menu Bar Monitor Comparisons | Better Resource Monitor",
    description: "Compare Better Resource Monitor with Stats, iStat Menus, and Eul to choose a lightweight macOS menu bar monitor.",
    heading: "Choose a Mac menu bar monitor",
    intro:
      "If you are deciding between Better Resource Monitor, Stats, iStat Menus, or Eul, start with the comparison that matches your use case. Each page covers resource use, privacy, pricing, App Store availability, and the tradeoffs that matter for daily monitoring.",
    cardLabel: "Read comparison",
  },
  es: {
    title: "Comparativas de monitores macOS | Better Resource Monitor",
    description: "Compara Better Resource Monitor con Stats, iStat Menus y Eul para elegir un monitor ligero en la barra de menús de macOS.",
    heading: "Elige un monitor para la barra de menús",
    intro:
      "Si estás decidiendo entre Better Resource Monitor, Stats, iStat Menus o Eul, empieza por la comparación que encaje con tu caso de uso. Cada página cubre consumo, privacidad, precio, disponibilidad en App Store y las diferencias importantes para el uso diario.",
    cardLabel: "Leer comparación",
  },
  "pt-br": {
    title: "Comparações de monitores macOS | Better Resource Monitor",
    description: "Compare o Better Resource Monitor com Stats, iStat Menus e Eul para escolher um monitor leve na barra de menus do macOS.",
    heading: "Escolha um monitor para a barra de menus",
    intro:
      "Se você está decidindo entre Better Resource Monitor, Stats, iStat Menus ou Eul, comece pela comparação que corresponde ao seu caso de uso. Cada página cobre consumo de recursos, privacidade, preço, disponibilidade na App Store e os pontos mais importantes para o uso diário.",
    cardLabel: "Ler comparação",
  },
  "zh-cn": {
    title: "macOS 菜单栏监视器对比 | Better Resource Monitor",
    description: "对比 Better Resource Monitor、Stats、iStat Menus 和 Eul，选择适合日常使用的轻量级 macOS 菜单栏监视器。",
    heading: "选择适合你的菜单栏监视器",
    intro:
      "如果你正在 Better Resource Monitor、Stats、iStat Menus 和 Eul 之间做选择，可以先查看最符合你使用场景的对比页面。每个页面都会介绍资源占用、隐私、价格、App Store 可用性，以及日常监控中真正重要的取舍。",
    cardLabel: "阅读对比",
  },
} satisfies Record<SupportedLocale, {
  title: string;
  description: string;
  heading: string;
  intro: string;
  cardLabel: string;
}>;

const comparisonKeys = ["vs-stats", "vs-istat-menus", "vs-eul"] satisfies ComparisonPageKey[];
const comparisons = await Promise.all(
  comparisonKeys.map(async (key) => {
    const entry = await getEntry("comparisons", `${key}/${locale}`);
    if (!entry) throw new Error(`Missing comparison content for ${key}/${locale}`);

    return {
      key,
      title: entry.data.heading,
      description: entry.data.description,
      href: getComparisonPath(locale, key),
    };
  }),
);
const copy = pageCopy[locale];
const faqItems = [
  ...pickFaqItems(faqEntry.data.items, "comparisonIndex"),
  ...getComparisonIndexFaqItems(locale),
];
---

<Layout title={copy.title} description={copy.description} locale={locale} slug="comparison">
  <main class="content-page comparison-index">
    <div class="container">
      <HomeLink href={getLocalizedPath(locale)} label={ui.backToHome} />

      <h1>{copy.heading}</h1>
      <p class="intro">{copy.intro}</p>

      <div class="comparison-grid" aria-label={copy.heading}>
        {comparisons.map((comparison) => (
          <a class="comparison-card content-panel" href={comparison.href}>
            <span class="card-title">{comparison.title}</span>
            <span class="card-description">{comparison.description}</span>
            <span class="card-link">
              <span>{copy.cardLabel}</span>
              <span style="display: flex; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
            </span>
          </a>
        ))}
      </div>

      <FaqSection locale={locale} heading={embeddedFaqHeadings.comparisonIndex[locale]} items={faqItems} />
    </div>
  </main>
</Layout>

<style>
  /* Hallmark · macrostructure: Long Document · tone: warm utility manual · anchor hue: ember
   * design-system: DESIGN.md · contrast: pass (40–41) · mobile: pass (34, 49, 50–57)
   * Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 */
  .comparison-index h1 {
    margin-bottom: var(--space-4);
    max-width: 760px;
  }

  .intro {
    color: var(--c-text-dim);
    font-size: 1.125rem;
    line-height: 1.7;
    margin: 0 0 var(--space-6);
    max-width: 760px;
  }

  .comparison-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }

  .comparison-card {
    color: var(--c-text);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
    padding: var(--space-5);
    text-decoration: none;
  }

  .comparison-card:focus-visible {
    outline: 3px solid var(--c-brand);
    outline-offset: 4px;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .card-description {
    color: var(--c-text-dim);
    line-height: 1.6;
  }

  .card-link {
    color: var(--c-on-brand);
    background-color: var(--c-brand);
    background-image: none;
    box-shadow: none;
    font-weight: 700;
    margin-top: auto;
    padding: 0 var(--space-2);
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    line-height: 1;
  }

</style>
