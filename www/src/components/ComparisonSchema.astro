---
interface Props {
  title: string;
  description: string;
  locale: SupportedLocale;
  slug: string;
  competitorName: string;
  competitorPrice: string;
}

import { getLocaleMeta, getLocalizedPath, type SupportedLocale } from "../lib/site";

const { title, description, locale, slug, competitorName, competitorPrice } = Astro.props;
const site = Astro.site?.origin ?? '';
const langTag = getLocaleMeta(locale).langTag;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "inLanguage": langTag,
  "url": `${site}${getLocalizedPath(locale, slug)}`,
  "mainEntity": {
    "@type": "SoftwareApplication",
    "name": "Better Resource Monitor",
    "inLanguage": langTag,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "macOS",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  },
  "about": {
    "@type": "SoftwareApplication",
    "name": competitorName,
    "inLanguage": langTag,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "macOS",
    "offers": { "@type": "Offer", "price": competitorPrice, "priceCurrency": "USD" },
  },
})} />
