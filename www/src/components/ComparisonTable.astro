---
interface Props {
  featureLabel: string;
  productLabel: string;
  competitorLabel: string;
  features: string[];
  productValues: string[];
  competitorValues: string[];
}

const { featureLabel, productLabel, competitorLabel, features, productValues, competitorValues } = Astro.props;
---

<table>
  <thead>
    <tr>
      <th>{featureLabel}</th>
      <th>{productLabel}</th>
      <th>{competitorLabel}</th>
    </tr>
  </thead>
  <tbody>
    {features.map((feature, i) => (
      <tr>
        <td><strong>{feature}</strong></td>
        <td><strong>{productValues[i]}</strong></td>
        <td>{competitorValues[i]}</td>
      </tr>
    ))}
  </tbody>
</table>
