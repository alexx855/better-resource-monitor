---
interface Props {
  caption: string;
  featureLabel: string;
  productLabel: string;
  competitorLabel: string;
  features: string[];
  productValues: string[];
  competitorValues: string[];
}

const { caption, featureLabel, productLabel, competitorLabel, features, productValues, competitorValues } = Astro.props;
---

<div class="table-scroll" tabindex="0" aria-label={caption}>
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{featureLabel}</th>
        <th scope="col">{productLabel}</th>
        <th scope="col">{competitorLabel}</th>
      </tr>
    </thead>
    <tbody>
      {features.map((feature, i) => (
        <tr>
          <th scope="row">{feature}</th>
          <td><strong>{productValues[i]}</strong></td>
          <td>{competitorValues[i]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
