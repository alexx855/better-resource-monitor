---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class="home-link" aria-label={label}>
  <span class="home-link__arrow" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="7 4 10 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
  </span>
  <span class="home-link__title">{label}</span>
</a>
