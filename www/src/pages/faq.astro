            "acceptedAnswer": {
              "@type": "Answer",
              "text": "On macOS, it reads device utilization from Apple Silicon GPUs through Apple's public IOAccelerator API. No private APIs, no sudo. Both the App Store and GitHub versions include GPU monitoring."
            }
          },
          {
            "@type": "Question",
            "name": "Does Better Resource Monitor collect any data?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Zero network requests, no analytics, no telemetry. Everything stays on your machine. The source code is on GitHub if you want to verify that yourself."
            }
