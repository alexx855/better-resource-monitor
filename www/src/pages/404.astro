---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 Not found"
  description="We couldn't find that page."
  locale="en"
  slug=""
  robots="noindex, nofollow"
  omitCanonical
>
  <main class="container content-page" style="text-align: center; padding-top: 120px; padding-bottom: 120px;">
    <h1 style="font-size: var(--fs-2xl);">404</h1>
    <p style="font-size: var(--fs-md);">That page doesn’t exist (or maybe the link got mangled).</p>
    <a href="/">Take me home</a>
  </main>
</Layout>
